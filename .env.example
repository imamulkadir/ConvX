# Run from the repository root. Copy to .env and supply your own secret token.
CONVX_ENVIRONMENT=development
CONVX_AUTH_MODE=token
# Empty tokens intentionally prevent startup. Generate with secrets.token_urlsafe(32).
CONVX_API_TOKENS={}
CONVX_DATABASE_URL=sqlite:///./var/convx.db
CONVX_REDIS_URL=redis://127.0.0.1:6379/0
CONVX_STORAGE_ROOT=./var/artifacts
CONVX_AUTO_CREATE_SCHEMA=false
CONVX_MAX_UPLOAD_BYTES=20971520
CONVX_MAX_REQUEST_BYTES=104857600
CONVX_MAX_BATCH_FILES=10
CONVX_MAX_ACTIVE_JOBS=20
CONVX_MAX_OWNED_STORAGE_BYTES=536870912
CONVX_MAX_ZIP_ENTRIES=2048
CONVX_MAX_EXPANDED_BYTES=134217728
CONVX_MAX_ENTRY_BYTES=16777216
CONVX_MAX_COMPRESSION_RATIO=200
CONVX_MAX_XML_DEPTH=128
CONVX_VALIDATION_TIMEOUT_SECONDS=20
CONVX_UPLOAD_TIMEOUT_SECONDS=120
CONVX_RETENTION_SECONDS=86400
CONVX_LEASE_SECONDS=120
CONVX_MAX_JOB_ATTEMPTS=3
CONVX_DISPATCH_LEASE_SECONDS=30
CONVX_MAX_DISPATCH_ATTEMPTS=20
CONVX_ORPHAN_GRACE_SECONDS=3600
CONVX_HEARTBEAT_SECONDS=10
CONVX_WORKER_STALE_SECONDS=45
# Stage 3 uses free LibreOffice only. Set an absolute path, e.g. D:/Tools/ConvX/.tools/libreoffice/program/soffice.com
# CONVX_LIBREOFFICE_EXECUTABLE=
CONVX_PROCESSING_TIMEOUT_SECONDS=300
CONVX_RENDERER_TIMEOUT_SECONDS=180
CONVX_RENDERER_MEMORY_BYTES=1073741824
CONVX_MAX_GENERATED_PDF_BYTES=67108864
CONVX_PDF_COMPARISON_DPI=96
CONVX_PDF_MAX_PAGES=500
CONVX_PDF_REQUIRE_REFERENCE=true
# Stage 4 layout model budgets; output remains private and never enters a filing ZIP.
CONVX_LAYOUT_MAX_TOTAL_CHARACTERS=500000
CONVX_LAYOUT_MAX_CHARACTERS_PER_PAGE=100000
CONVX_LAYOUT_MAX_BYTES=67108864
CONVX_LAYOUT_MEMORY_BYTES=805306368
