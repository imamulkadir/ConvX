    "check:format": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "daisyui": "5.7.50",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
