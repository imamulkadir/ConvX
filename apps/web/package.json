{
  "name": "convx-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
